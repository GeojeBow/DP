<Window x:Class="NeoDir.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NeoDir"
        Title="NeoDir" Width="1400" Height="860" MinWidth="720" MinHeight="420"
        Icon="pack://application:,,,/Assets/NeoDir.png"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown" StateChanged="OnStateChanged" Closing="OnClosing" Loaded="OnLoaded"
        Activated="OnActivated">
    <Window.Resources>
        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type local:SidebarItem}">
            <Button Style="{StaticResource SidebarButton}" Tag="{Binding}" Click="OnSidebarItemClick"
                    MouseUp="OnSidebarItemMouseUp" ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource AccentGradient}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <Grid Visibility="{Binding UsageVisibility}" Height="4" Margin="0,5,0,1">
                            <Border CornerRadius="2" Background="{StaticResource Surface2Brush}" />
                            <Border CornerRadius="2" Background="{StaticResource AccentGradient}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Usage}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <DockPanel Background="{StaticResource BgBrush}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="최소화" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="최대화" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="닫기" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Assets/NeoDir.png" Width="18" Height="18" />
                    <TextBlock Text="NeoDir" FontSize="14" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentGradient}" />

                    <Border Margin="22,0,0,0" Padding="3" CornerRadius="9" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Layout1" Style="{StaticResource LayoutButton}" Tag="Single" Checked="OnLayoutChecked" ToolTip="1개 패널 (Ctrl+1)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M1,1 H17 V13 H1 Z" />
                            </RadioButton>
                            <RadioButton x:Name="Layout2" Style="{StaticResource LayoutButton}" Tag="TwoColumns" Checked="OnLayoutChecked" ToolTip="좌우 2개 (Ctrl+2)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M1,1 H17 V13 H1 Z M9,1 V13" />
                            </RadioButton>
                            <RadioButton x:Name="Layout3" Style="{StaticResource LayoutButton}" Tag="TwoRows" Checked="OnLayoutChecked" ToolTip="위아래 2개 (Ctrl+3)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M1,1 H17 V13 H1 Z M1,7 H17" />
                            </RadioButton>
                            <RadioButton x:Name="Layout4" Style="{StaticResource LayoutButton}" Tag="Three" Checked="OnLayoutChecked" ToolTip="3개 (Ctrl+4)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M1,1 H17 V13 H1 Z M9,1 V13 M9,7 H17" />
                            </RadioButton>
                            <RadioButton x:Name="Layout5" Style="{StaticResource LayoutButton}" Tag="Four" Checked="OnLayoutChecked" ToolTip="4개 (Ctrl+5)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M1,1 H17 V13 H1 Z M9,1 V13 M1,7 H17" />
                            </RadioButton>
                            <Border Width="1" Margin="4,5" Background="{StaticResource BorderBrush}" />
                            <RadioButton x:Name="Layout6" Style="{StaticResource LayoutButton}" Tag="ThreeRows" Checked="OnLayoutChecked" ToolTip="세로 모니터: 위아래 3단 (Ctrl+6)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M4,0.5 H14 V13.5 H4 Z M4,4.8 H14 M4,9.2 H14" />
                            </RadioButton>
                            <RadioButton x:Name="Layout7" Style="{StaticResource LayoutButton}" Tag="FourRows" Checked="OnLayoutChecked" ToolTip="세로 모니터: 위아래 4단 (Ctrl+7)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M4,0.5 H14 V13.5 H4 Z M4,3.75 H14 M4,7 H14 M4,10.25 H14" />
                            </RadioButton>
                            <RadioButton x:Name="Layout8" Style="{StaticResource LayoutButton}" Tag="OneOverTwo" Checked="OnLayoutChecked" ToolTip="세로 모니터: 위 1개 + 아래 2개 (Ctrl+8)">
                                <Path Style="{StaticResource LayoutGlyph}" Data="M4,0.5 H14 V13.5 H4 Z M4,7 H14 M9,7 V13.5" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton x:Name="SidebarToggle" Style="{StaticResource ToggleIcon}" Content="&#xE700;"
                                      ToolTip="사이드바 (Ctrl+B) · 오른쪽 클릭: 위치 바꾸기" Click="OnSidebarToggle"
                                      PreviewMouseRightButtonUp="OnSidebarDockMenu" />
                        <ToggleButton x:Name="PreviewToggle" Style="{StaticResource ToggleIcon}" Content="&#xE8A1;"
                                      ToolTip="미리보기 패널 (Ctrl+P) · 오른쪽 클릭: 위치 바꾸기" Click="OnPreviewToggle"
                                      PreviewMouseRightButtonUp="OnPreviewDockMenu" />
                        <ToggleButton x:Name="HiddenToggle" Style="{StaticResource ToggleIcon}" Content="&#xE7B3;"
                                      ToolTip="숨김 파일 보기 (Ctrl+H)" Click="OnHiddenToggle" />
                        <Button x:Name="WorkspaceButton" Style="{StaticResource IconButton}" Width="Auto"
                                ToolTip="작업공간: 지금 레이아웃과 탭을 저장하고 한 번에 불러오기" Click="OnWorkspaceClick">
                            <StackPanel Orientation="Horizontal" Margin="9,0">
                                <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                <TextBlock x:Name="WorkspaceLabel" Text="작업공간" FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE897;" Foreground="{StaticResource SubTextBrush}"
                                ToolTip="단축키 도움말 (F1)" Click="OnHelpClick" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Body: the sidebar and preview are docked around the panes in code (ArrangeDocks) -->
            <Grid x:Name="Body" Grid.Row="1" Margin="4,0,4,4">
                <!-- Sidebar -->
                <ScrollViewer x:Name="Sidebar" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="SidebarSections">
                        <StackPanel x:Name="FavoritesSection">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="10"
                                        Width="24" Height="22" Margin="0,8,8,0" ToolTip="현재 폴더를 즐겨찾기에 추가 (Ctrl+D)"
                                        Foreground="{StaticResource SubTextBrush}" Click="OnAddFavoriteClick" />
                                <TextBlock Text="즐겨찾기" Style="{StaticResource SectionHeader}" />
                            </DockPanel>
                            <Border x:Name="FavoritesDrop" Background="Transparent" AllowDrop="True" Drop="OnFavoritesDrop"
                                    DragOver="OnFavoritesDragOver" MinHeight="8">
                                <Grid>
                                    <ItemsControl x:Name="FavoritesList" />
                                    <TextBlock x:Name="FavoritesHint" Margin="18,2,12,6" TextWrapping="Wrap" FontSize="11.5"
                                               Foreground="{StaticResource SubTextBrush}"
                                               Text="폴더를 여기로 끌어 놓거나 ☆ 버튼을 누르면 추가돼요." />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="QuickSection">
                            <TextBlock Text="빠른 이동" Style="{StaticResource SectionHeader}" />
                            <ItemsControl x:Name="QuickList" />
                        </StackPanel>

                        <StackPanel x:Name="DrivesSection">
                            <TextBlock Text="드라이브" Style="{StaticResource SectionHeader}" />
                            <ItemsControl x:Name="DriveList" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="PaneHost" />

                <local:PreviewPanel x:Name="Preview" Visibility="Collapsed" />

                <!-- Toast -->
                <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                        Padding="16,10" CornerRadius="10" Background="{StaticResource Surface2Brush}" BorderThickness="1"
                        BorderBrush="{StaticResource AccentSoftBrush}" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="640">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <!-- Status bar -->
            <DockPanel Grid.Row="2" Margin="14,0,14,4">
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SubTextBrush}" FontSize="11.5" VerticalAlignment="Center"
                           Text="F6 패널 이동 · Ctrl+T 새 탭 · Ctrl+F 필터 · Shift+Enter 옆 패널에서 열기" />
                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGradient}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource SubTextBrush}" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>
    </Border>

</Window>
