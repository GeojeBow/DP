<UserControl x:Class="NeoDir.FolderPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NeoDir">
    <Border x:Name="Frame" Margin="3" CornerRadius="10" BorderThickness="1"
            BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Accent line on the active pane. -->
            <Border x:Name="ActiveGlow" Height="2" VerticalAlignment="Top" Margin="14,0" CornerRadius="1"
                    Background="{StaticResource AccentGradient}" Visibility="Hidden" />

            <!-- Tabs -->
            <DockPanel Margin="6,6,6,0" Background="Transparent" MouseLeftButtonDown="OnTabStripBackgroundClick">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="11"
                        Width="26" Height="26" ToolTip="새 탭 (Ctrl+T)" Click="OnNewTabClick" />
                <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="OnTabSelectionChanged" PreviewMouseWheel="OnTabStripWheel"
                         PreviewMouseDown="OnTabStripMouseDown" Focusable="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,5,4,5" Margin="0,0,3,0">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FolderTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Title}" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Width="20" Height="20"
                                        Margin="6,0,0,0" Tag="{Binding}" Click="OnCloseTabClick" ToolTip="탭 닫기 (Ctrl+W)" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Navigation, address, filter -->
            <Grid Grid.Row="1" Margin="6,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="뒤로 (Alt+←)" Click="OnBackClick" />
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="앞으로 (Alt+→)" Click="OnForwardClick" />
                    <Button x:Name="UpButton" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="상위 폴더 (Backspace)" Click="OnUpClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="새로 고침 (F5)" Click="OnRefreshClick" />
                </StackPanel>

                <Border x:Name="AddressBar" Grid.Column="1" Margin="6,0" Height="30" CornerRadius="7"
                        Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Cursor="IBeam" MouseLeftButtonUp="OnAddressBarClick" ToolTip="클릭해서 경로 입력 (Ctrl+L)">
                    <Grid>
                        <ScrollViewer x:Name="CrumbScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      Margin="3,0">
                            <ItemsControl x:Name="Crumbs" VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Arrow">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CrumbView}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource CrumbButton}" Padding="3,2" Visibility="{Binding ChevronVisibility}"
                                                    Tag="{Binding ParentPath}" Click="OnChevronClick" ToolTip="하위 폴더 보기">
                                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                           Foreground="{StaticResource SubTextBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource CrumbButton}" Content="{Binding Label}" Tag="{Binding Path}"
                                                    Click="OnCrumbClick" MouseDown="OnCrumbMouseDown" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBox x:Name="AddressBox" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}" VerticalContentAlignment="Center" Padding="6,0"
                                 KeyDown="OnAddressKeyDown" LostKeyboardFocus="OnAddressLostFocus" />
                    </Grid>
                </Border>

                <Button x:Name="FavoriteButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE734;"
                        ToolTip="즐겨찾기에 추가 (Ctrl+D)" Click="OnFavoriteClick" Margin="0,0,4,0" />

                <Grid Grid.Column="3">
                    <TextBox x:Name="FilterBox" Style="{StaticResource FieldBox}" Height="30" Padding="26,0,6,0"
                             TextChanged="OnFilterChanged" PreviewKeyDown="OnFilterKeyDown"
                             ToolTip="입력하면 이 폴더에서 바로 거르고, Enter를 누르면 하위 폴더까지 찾아요. 띄어쓰기 = 모두 포함, ; = 또는, *.pdf 같은 와일드카드 가능" />
                    <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="12" IsHitTestVisible="False"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock x:Name="FilterHint" Text="필터 · Enter=하위 폴더 검색" IsHitTestVisible="False" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="30,0,0,0" />
                </Grid>
            </Grid>

            <!-- Files -->
            <Grid Grid.Row="2">
                <ListView x:Name="List" Style="{StaticResource FileList}" Margin="0,0,2,6"
                          TextSearch.TextPath="Name" IsTextSearchEnabled="True"
                          GridViewColumnHeader.Click="OnHeaderClick"
                          SelectionChanged="OnListSelectionChanged"
                          PreviewKeyDown="OnListKeyDown"
                          PreviewMouseLeftButtonDown="OnListMouseDown"
                          PreviewMouseLeftButtonUp="OnListMouseUp"
                          PreviewMouseMove="OnListMouseMove"
                          MouseDown="OnListMiddleClick"
                          ContextMenuOpening="OnListContextMenuOpening"
                          DragOver="OnListDragOver" Drop="OnListDrop">
                    <ListView.ContextMenu>
                        <ContextMenu />
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn Width="300">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Name" Content="이름" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:FileEntry}">
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, TargetNullValue={StaticResource TextBrush}}" />
                                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="7,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}"
                                                       Visibility="{Binding CloudVisibility}" ToolTip="온라인 전용 (열면 다운로드돼요)" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="140" DisplayMemberBinding="{Binding ModifiedText}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Modified" Content="수정한 날짜" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="130" DisplayMemberBinding="{Binding TypeName}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Type" Content="유형" />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Size" Content="크기" HorizontalContentAlignment="Right" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:FileEntry}">
                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,40,20,20"
                           Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
