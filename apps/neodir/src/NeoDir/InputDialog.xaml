<Window x:Class="NeoDir.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}">
    <Border Margin="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="20,18" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" />
            <TextBox x:Name="Input" Style="{StaticResource FieldBox}" Margin="0,12,0,0" Height="34" TextChanged="OnTextChanged" />
            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="취소" Style="{StaticResource SubtleButton}" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="OkButton" Content="확인" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
